# Frontend environment variables
# Copy to .env.local for development

# API base URL (empty = same origin, proxied via Vite dev server)
VITE_API_URL=

# WebSocket base URL (empty = same origin)
VITE_WS_URL=

# For production deployments:
# VITE_API_URL=https://api.nexachat.app
# VITE_WS_URL=wss://api.nexachat.app
