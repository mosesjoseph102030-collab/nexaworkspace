# ─── NEXACHAT Environment Variables ───────────────────────────────────────────
# Copy this file to .env and fill in all values before running.

# ── App ────────────────────────────────────────────────────────────────────────
APP_NAME=NEXACHAT
ENV=dev                          # dev | staging | prod
DEBUG=true

# ── Database ───────────────────────────────────────────────────────────────────
# Development (SQLite — zero setup):
DATABASE_URL=sqlite+aiosqlite:///./nexachat_dev.db

# Production (PostgreSQL via asyncpg):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/nexachat

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ────────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-32-char-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── AI ─────────────────────────────────────────────────────────────────────────
AI_PROVIDER=openai               # openai | anthropic
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
AI_RATE_LIMIT_PER_HOUR=30

# ── Sentry (optional) ──────────────────────────────────────────────────────────
SENTRY_DSN=
